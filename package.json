{
  "name": "dot-study",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:demo": "npm run dev:demo -w frontend",
    "dev:api": "npm run dev:api -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run format:check",
    "format": "prettier --write \"{shared,frontend,backend}/**/*.{ts,tsx,css,json}\" \"*.{js,json}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"{shared,frontend,backend}/**/*.{ts,tsx,css,json}\" \"*.{js,json}\" \".github/**/*.yml\""
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.2"
  }
}
